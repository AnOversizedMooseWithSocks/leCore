# openzoo for aider (AI pair programming in your terminal).
# Source this file, then run aider with an openai/ model prefix:
#
#   source integrations/aider/openzoo.env      # git-bash / MINGW64 / linux
#   aider --model openai/nvidia/nemotron-3.5-lightning
#
# WHY env vars instead of a plugin: aider has no plugin system; it reads
# the standard OPENAI_API_BASE / OPENAI_API_KEY variables and treats any
# openai/-prefixed model as living at that base. Two exports is the whole
# integration.

export OPENAI_API_BASE="http://localhost:8402/v1"   # hosted: https://api.openzoo.fun/v1
export OPENAI_API_KEY="sk-openzoo"                  # any value for local proxy; real key for hosted
